// The Cloudflare build. `npm run cloudflare:build` gathers the page into .cloudflare/assets first.
{
  "name": "app",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": ".cloudflare/assets", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "InboxObject" }, { "name": "REGISTRY", "class_name": "RegistryObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxObject", "RegistryObject"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "your-attention-files" }],
  "kv_namespaces": [{ "binding": "INVITES", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  // A limit per inbox: 600 API requests a minute, and 100 MB of files over its life. R2 deletes each file after 30 days (cloudflare/main.tf).
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  "vars": { "MODE": "single", "UPLOAD_LIMIT_BYTES": "104857600" }
}
