{
  "name": "your-attention",
  "version": "0.1.0",
  "description": "One inbox where all your coding agents ask you questions as cards, and your answers reach them at once.",
  "license": "MIT",
  "type": "module",
  "repository": "github:elecnix/your-attention",
  "keywords": ["pi-package", "claude-code", "coding-agents", "inbox"],
  "engines": { "node": ">=22.18" },
  "bin": { "your-attention": "bin/your-attention.js" },
  "pi": { "extensions": ["./src/integrations/pi/extension.ts"] },
  "scripts": {
    "typecheck": "npm run typecheck:tsgo && npm run typecheck:tsc-rs",
    "typecheck:tsgo": "tsgo --noEmit -p .",
    "typecheck:tsc-rs": "tsc-rs --noEmit -p .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --disable-warning=ExperimentalWarning \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/integration/**/*.test.ts\"",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/browser-bundle": "0.2.1",
    "bonjour-service": "1.4.4",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsc-rs": "0.8.0"
  }
}
