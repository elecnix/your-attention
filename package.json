{
  "name": "your-attention",
  "version": "0.1.0",
  "description": "One inbox where all your coding agents ask you questions as cards, and your answers reach them at once.",
  "license": "MIT",
  "type": "module",
  "repository": "github:elecnix/your-attention",
  "keywords": [
    "pi-package",
    "claude-code",
    "coding-agents",
    "inbox"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "your-attention": "bin/your-attention.js"
  },
  "pi": {
    "extensions": [
      "./src/integrations/pi/extension.ts"
    ]
  },
  "scripts": {
    "typecheck": "npm run typecheck:tsgo && npm run typecheck:tsc-rs",
    "typecheck:tsgo": "tsgo --noEmit -p . && tsgo --noEmit -p tsconfig.cloudflare.json",
    "typecheck:tsc-rs": "tsc-rs --noEmit -p . && tsc-rs --noEmit -p tsconfig.cloudflare.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --disable-warning=ExperimentalWarning \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/integration/**/*.test.ts\"",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "test:browser": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "cloudflare:build": "node scripts/cloudflare-assets.mjs",
    "cloudflare:check": "npm run cloudflare:build && wrangler deploy --dry-run --outdir .cloudflare/dist",
    "test:cloudflare": "npm run cloudflare:build && node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/cloudflare/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/browser-bundle": "0.2.1",
    "bonjour-service": "1.4.4",
    "typebox": "1.4.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@playwright/test": "1.64.1",
    "@storybook/html-vite": "10.6.4",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "storybook": "10.6.4",
    "tsc-rs": "0.8.0",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  }
}
