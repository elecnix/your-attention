{
  "vale": ["vale"],
  "classifier": ["pr-context-classifier", "-m", "openai/gpt-oss-120b"],
  "valeTimeoutMs": 30000,
  "classifierTimeoutMs": 150000,
  "prVerdict": {
    "command": ["/path/to/your/pr-verdict-command"],
    "acceptVerdicts": ["ACCEPT"],
    "timeoutMs": 300000
  },
  "policy": {
    "valeErrors": "block",
    "valeWarnings": "advise",
    "classifierMissingContext": "block",
    "prVerdictBlockBelow": 0.5
  },
  "maxReturns": 3,
  "screen": "new",
  "stateFile": "~/.local/state/your-attention/triage-example.json"
}
